{
  "name": "jarvis-app",
  "productName": "JARVIS",
  "version": "1.3.0",
  "description": "JARVIS - a desktop app for Claude Code in the BantuApps workspace",
  "main": "src/main.mjs",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "smoke": "node scripts/smoke.mjs",
    "shortcuts": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/shortcuts.ps1",
    "brand-bot": "node scripts/telegram-brand.mjs",
    "test": "node scripts/content-test.mjs && node scripts/remote-test.mjs && node scripts/presence-test.mjs && node scripts/deploy-test.mjs && node scripts/gitai-test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.284",
    "@huggingface/transformers": "^4.3.0",
    "@yume-chan/adb": "^2.6.4",
    "@yume-chan/adb-scrcpy": "^2.3.2",
    "@yume-chan/adb-server-node-tcp": "^2.5.2",
    "@yume-chan/scrcpy": "^2.3.0",
    "@yume-chan/stream-extra": "^2.6.1",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "ogg-opus-decoder": "^1.7.5"
  },
  "devDependencies": {
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3"
  },
  "author": "BantuApps",
  "build": {
    "appId": "com.bantuapps.jarvis",
    "productName": "JARVIS",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "build/icon.png",
      "build/icon.ico",
      "package.json",
      "vendor/**",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/{darwin,linux}/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
      "!node_modules/@img/sharp-wasm32/**"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-win32-x64/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "build/icon.*"
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    }
  }
}
